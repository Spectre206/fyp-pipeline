        {
          "refId": "A",
          "expr": "sum(fyp_fusion_published_total)",
          "legendFormat": "Published",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Current-process incidents correlated by Fusion and sent from Layer 1 to Layer 2."
