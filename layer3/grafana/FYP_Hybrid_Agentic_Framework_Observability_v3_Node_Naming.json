    {
      "type": "row",
      "title": "03 \u2014 STREAMING DATA PLANE / Fusion Engine",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "title": "Fusion Suppression Rate",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(fyp_fusion_suppressed_total) / (sum(fyp_fusion_published_total) + sum(fyp_fusion_suppressed_total))",
          "legendFormat": "Suppression"
