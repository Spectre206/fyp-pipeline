{
  "title": "Hybrid Agentic Framework \u2014 System Observability",
  "uid": "fyp-observability-v2",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "row",
      "title": "System Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "title": "Events Processed / Anomalies",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(fyp_fusion_published_total) + sum(fyp_fusion_suppressed_total)",
          "legendFormat": "Total"
        },
        {
          "expr": "sum(fyp_fusion_published_total)",
          "legendFormat": "Anomalies"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "description": "Total synthetic events ingested by Layer 1 and how many were flagged anomalous."
    },
    {
      "title": "Fusion Published",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(fyp_fusion_published_total)",
          "legendFormat": "Published"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "description": "Count of correlated incidents the Fusion Engine published downstream to Layer 2."
    },
    {
      "title": "Fusion Suppressed",
      "type": "stat",
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(fyp_fusion_suppressed_total)",
          "legendFormat": "Suppressed"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "description": "Count of duplicate/correlated detector alerts the Fusion Engine suppressed before publishing."
    },
    {
      "title": "System Health",
      "type": "stat",
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=~'fyp-agent-pipeline|fyp-layer3-autoexec|fyp-cluster'}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "description": "Quick rollup of currently reachable pipeline components (Prometheus 'up' targets)."
    },
    {
      "title": "Pipeline Health (components up)",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(up == 1)",
          "legendFormat": "Components Up"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "description": "Per-component up/down status across the three-node cluster."
    },
    {
      "type": "row",
      "title": "02 \u2014 COMMODITY HARDWARE",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "title": "Stream Engine",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"fyp-cluster\",instance=\"stream-node:9100\"}",
          "legendFormat": "UP",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Liveness of the stream-node (Layer 1: event generator, validator, detectors, fusion engine)."
    },
    {
      "title": "AI Brain",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"fyp-cluster\",instance=\"ai-brain-node:9100\"}",
          "legendFormat": "UP",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Liveness of the ai-brain-node (Layer 2: Triage, Strategy, Policy, Learning agents)."
    },
    {
      "title": "Gateway Node (HITL, Actions & Monitoring)",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"fyp-cluster\",instance=\"gateway-node:9100\"}",
          "legendFormat": "UP",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Liveness of the gateway-node (Layer 3: HITL dashboard, Action Executor; also hosts Prometheus/Grafana)."
    },
    {
      "title": "CPU Utilization (%)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"fyp-cluster\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "description": "Per-node CPU usage \u2014 the primary commodity-hardware constraint this FYP evaluates against."
    },
    {
      "title": "Memory Utilization (%)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"fyp-cluster\"} / node_memory_MemTotal_bytes{job=\"fyp-cluster\"}))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "description": "Per-node RAM usage, notably on ai-brain-node while Qwen3 models are loaded for inference."
    },
    {
      "title": "Root Filesystem Usage (%)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"fyp-cluster\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"fyp-cluster\",mountpoint=\"/\"}))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "description": "Per-node disk usage for the cluster's root filesystem."
    },
    {
      "title": "Network Throughput (bit/s)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"fyp-cluster\",device!~\"lo|docker.*|veth.*|br-.*\"}[5m])) * 8",
          "legendFormat": "{{instance}} RX",
          "refId": "A"
        },
        {
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=\"fyp-cluster\",device!~\"lo|docker.*|veth.*|br-.*\"}[5m])) * 8",
          "legendFormat": "{{instance}} TX",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bits"
        }
      },
      "description": "Inbound/outbound network traffic per node over the Ethernet-connected cluster."
    },
    {
      "title": "Maximum Hardware Sensor Temperature",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"fyp-cluster\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      },
      "description": "Highest reported hardware sensor temperature per node, for thermal-throttling checks during sustained load."
    },
    {
      "title": "NTP / Clock Offset",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "node_timex_offset_seconds{job=\"fyp-cluster\"} * 1000",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "Clock drift per node vs. NTP reference \u2014 relevant to cross-node timestamp accuracy in MTTA/MTTR calculations."
    },
    {
      "type": "row",
      "title": "03 \u2014 STREAMING DATA PLANE / Validator",
