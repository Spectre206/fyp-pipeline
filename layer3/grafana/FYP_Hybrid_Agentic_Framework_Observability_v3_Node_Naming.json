    {
      "title": "Valid Events",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 24,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(fyp_validator_valid_total)",
          "legendFormat": "Valid"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "description": "Events that passed schema validation and proceeded to the detector layer."
    },
    {
      "title": "Schema Violations",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(fyp_validator_schema_violations_total)",
          "legendFormat": "Violations"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "description": "Events rejected by the Pydantic validator for failing schema checks."
    },
    {
      "title": "Validator Success Rate",
      "type": "gauge",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(fyp_validator_valid_total) / sum(fyp_validator_events_total)",
          "legendFormat": "Success"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "description": "Share of ingested events that passed schema validation."
    },
    {
      "title": "Validator Latency (ms)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(fyp_validator_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "p95"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bfg3227zf71tsd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "p50/p95 time for the Pydantic validator to process a single event."
    },
    {
      "type": "row",
      "title": "03 \u2014 STREAMING DATA PLANE / Detectors",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "title": "Detector Evaluations",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
