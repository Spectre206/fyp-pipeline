        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "EMA Confidence Threshold",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "min": 0.6,
          "max": 0.9
        }
      },
      "targets": [
        {
          "expr": "fyp_learning_confidence_threshold",
          "legendFormat": "threshold"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "Learning Outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 56,
        "w": 10,
        "h": 4
      },
