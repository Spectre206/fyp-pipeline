{
  "uid": "fyp-threshold-baseline-v1",
  "title": "FYP Threshold-Only Baseline Observability",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "10s",
  "tags": [
    "fyp",
    "threshold-only"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Experiment Prometheus"
      },
      {
        "name": "mode",
        "type": "custom",
        "query": "Mode A (Layer 1 N/A),Mode B",
        "current": {
          "text": "Mode A (Layer 1 N/A)",
          "value": "Mode A (Layer 1 N/A)"
        },
        "options": [
          {
            "text": "Mode A (Layer 1 N/A)",
            "value": "Mode A (Layer 1 N/A)",
            "selected": true
          },
          {
            "text": "Mode B",
            "value": "Mode B",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SYSTEM OVERVIEW",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Unique incidents",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fyp_threshold_incidents_received_total{job=\"fyp-threshold-baseline\"})",
          "legendFormat": "{{instance}} {{route}} {{reason}} {{outcome}} {{detector}} {{risk}} {{worker}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Operational metric; use the offline ID-based analyzer for formal run totals. No data is not zero."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Confirmed decisions",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
